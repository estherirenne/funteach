# Salin file ini jadi .env  ->  cp .env.example .env
# Lalu ganti POSTGRES_PASSWORD dengan password buatan sendiri. JANGAN commit file .env.
APP_PORT=8000
POSTGRES_USER=funteach
POSTGRES_PASSWORD=ganti_dengan_password_sendiri
POSTGRES_DB=funteach
# Aplikasi menyambung ke database lewat NAMA SERVICE di compose ("db"), bukan localhost.
DB_HOST=db
DB_PORT=5432
